<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net472</TargetFramework>
		<PlatformTarget>AnyCPU</PlatformTarget>

		<!-- Modify [RootNamespace], [AssemblyName], [OutputPath], [VersionPrefix] -->
		<RootNamespace>OOPhoenixLords</RootNamespace>
		<AssemblyName>PhoenixLords</AssemblyName>
		<OutputPath>../1.6/Assemblies</OutputPath>
		<VersionPrefix>0.1.0.0</VersionPrefix>

		<!-- Do not generate pdb file -->
		<DebugType>none</DebugType>

		<DebugSymbols>false</DebugSymbols>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<RimWorldPath Condition="'$(RimWorldPath)' == '' AND '$(OS)' == 'Windows_NT'">../../../RimWorldWin64_Data/Managed</RimWorldPath>
        <RimWorldPath Condition="'$(RimWorldPath)' == '' AND '$(OS)' != 'Windows_NT'">../../../RimWorldLinux_Data/Managed</RimWorldPath>
        <LangVersion>latest</LangVersion>
	</PropertyGroup>

 	<ItemGroup>
	 	<!-- Mod -->
	 	<Compile Include="../1.6/Source/**/*" />
		
	 	<!-- Rimworld -->
	 	<Reference Include="$(RimWorldPath)/*.dll">
			<Private>False</Private>
		</Reference>

		<!-- *Uncomment for Harmony*-->
		<Reference Include="../../../../../../steamapps/workshop/content/294100/2009463077/Current/Assemblies/0Harmony.dll">
			<Private>False</Private>
		</Reference>
		<!-- *Uncomment for PhoenixRebirth*-->
		<Reference Include="../../../../../../steamapps/workshop/content/294100/3736576229/Assemblies/PhoenixRebirth.dll">
			<Private>False</Private>
		</Reference>
		<Compile Update="..\1.6\Source\ThingDefs\PhoenixLordsHistoryEventDefs.cs">
		  <Link>ThingDefs\PhoenixLordsHistoryEventDefs.cs</Link>
		</Compile>
	</ItemGroup>
</Project>
