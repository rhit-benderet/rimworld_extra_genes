<Defs>
    <ThingDef ParentName="ApparelMakeableBase">
        <defName>OOPhoenixLords_Apparel_PhoenixShirt</defName>
        <label>phoenix shirt</label>
        <description>A shirt that can withstand large amounts of heat. Although originally developed for use in battle against phoenix lords, it sees most of its use on phoenix lords as it can withstand their large body temperature.</description>
        <recipeMaker>
            <researchPrerequisites>
                <li>ComplexClothing</li>
                <li>Devilstrand</li>
            </researchPrerequisites>
            <displayPriority>205</displayPriority>
        </recipeMaker>
        <costList>
            <DevilstrandCloth>60</DevilstrandCloth>
            <Chemfuel>30</Chemfuel>
        </costList>
        <graphicData>
            <texPath>Things/Pawn/Humanlike/Apparel/ShirtPhoenix/ShirtPhoenix</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <thingCategories>
            <li>ApparelMisc</li>
        </thingCategories>
        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <WorkToMake>1600</WorkToMake>
            <Mass>0.25</Mass>
            <ArmorRating_Sharp>0.28</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.072</ArmorRating_Blunt>
            <ArmorRating_Heat>1.2</ArmorRating_Heat>
            <Insulation_Cold>4.4</Insulation_Cold>
            <Insulation_Heat>6.2</Insulation_Heat>
            <EquipDelay>1.5</EquipDelay>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Pawn/Humanlike/Apparel/ShirtPhoenix/ShirtPhoenix</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>IndustrialBasic</li>
            </tags>
            <defaultOutfitTags>
                <li>Worker</li>
                <li>Soldier</li>
                <li>Spacefarer</li>
            </defaultOutfitTags>
            <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
        </apparel>
        <tradeTags>
            <li>BasicClothing</li>
        </tradeTags>
    </ThingDef>
