<Defs>
    <AbilityDef>
    <defName>OOPhoenixLords_PhoenixFireSpew</defName>
    <label>phoenix fire spew</label>
    <description>Releases a large burst of fresh phoenix flames from their hands. These flames will burn anything in a small area and can ignite people, objects, and the ground.</description>
    <iconPath>UI/Abilities/PhoenixFireSpew</iconPath>
    <cooldownTicksRange>10</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <ai_IsIncendiary>true</ai_IsIncendiary>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <warmupStartSound>FireSpew_Warmup</warmupStartSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>20.9</range>
      <warmupTime>1</warmupTime>
      <soundCast>FireSpew_Resolve</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityFireSpew">
        <range>20.9</range>
        <lineWidthEnd>6</lineWidthEnd>
        <filthDef>OOPhoenixLords_Filth_SuperheatedChemfuel</filthDef>
        <effecterDef>Fire_Spew</effecterDef>
        <canHitFilledCells>true</canHitFilledCells>
      </li>
      <li Class="OOPhoenixLords.CompProperties_AbilityPhoenixFlamesCost">
        <phoenixFlamesCost>1.0</phoenixFlamesCost>
      </li>
    </comps>
  </AbilityDef>
  <AbilityDef>
    <defName>OOPhoenixLords_PhoenixFireBurst</defName>
    <label>phoenix fire burst</label>
    <description>Emit a burst of phoenix fire in all directions to form puddles of ignited liquid on the ground.</description>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <iconPath>UI/Abilities/PhoenixFireBurst</iconPath>
    <cooldownTicksRange>10</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <targetRequired>false</targetRequired>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <showCastingProgressBar>true</showCastingProgressBar>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupEffecter>Fire_Burst_Warmup</warmupEffecter>
      <warmupTime>3</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <range>13.9</range>
      <drawAimPie>false</drawAimPie>      
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="OOPhoenixLords.CompProperties_AbilityPhoenixFireBurst">
        <radius>13.9</radius>
      </li>
      <li Class="OOPhoenixLords.CompProperties_AbilityPhoenixFlamesCost">
        <phoenixFlamesCost>5.0</phoenixFlamesCost>
      </li>
    </comps>
  </AbilityDef> 
    <AbilityDef Name="OOPhoenixLords_PhoenixFlight">
    <defName>OOPhoenixLords_PhoenixFlight</defName>
    <label>phoenix flight</label>
    <description>Fly to a distant location and leave a trail of flames in your path.</description>
    <iconPath>UI/Abilities/PhoenixFlight</iconPath>
    <cooldownTicksRange>10</cooldownTicksRange>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>OOPhoenixLords.Verb_CastAbilityPheonixFlight</verbClass>
      <label>fly</label>
      <violent>false</violent>
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
      <warmupTime>0.5</warmupTime>
      <range>29.9</range>
      <requireLineOfSight>true</requireLineOfSight>
      <soundCast>Longjump_Jump</soundCast>
      <soundLanding>Longjump_Land</soundLanding>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="OOPhoenixLords.CompProperties_AbilityPhoenixFlamesCost">
        <phoenixFlamesCost>4.0</phoenixFlamesCost>
      </li>
      <li Class="OOPhoenixLords.CompProperties_AbilityLeaveFlamePath">
        <radius>6</radius>
      </li>
    </comps>
  </AbilityDef>
</Defs>