<?xml version="1.0" encoding="utf-8"?>
<Defs> 
  <GeneDef>
    <defName>OOPhoenixLords_PhoenixFire</defName>
    <label>phoenix fire</label>
    <description>Archites distributed in the blood burn chemfuel into bright phoenix flames inside the carrier. Phoenix flames replenish faster the longer chemfuel has been burning uninterrupted and the more chemfuel is being burned and deplete faster the more flames are in the carrier. The carrier can utilize these flames to power abilities, items, and buildings which require phoenix flames.</description>
    <geneClass>OOPhoenixLords.Gene_PhoenixFire</geneClass>
    <iconPath>UI/Icons/Genes/Gene_PhoenixFire</iconPath>
    <displayCategory>Archite</displayCategory>
    <marketValueFactor>3</marketValueFactor>
    <biostatCpx>3</biostatCpx>
    <biostatArc>2</biostatArc>
    <customEffectDescriptions>
      <li>Allows a pawn to utilize genes, items, or buildings that require phoenix flames.</li>
    </customEffectDescriptions>
    <resourceGizmoType>OOPhoenixLords.GeneGizmo_ResourceChemfuel</resourceGizmoType>
    <resourceLabel>chemfuel</resourceLabel>
    <resourceGizmoThresholds>
      <li>0.25</li>
      <li>0.5</li>
      <li>0.75</li>
    </resourceGizmoThresholds>
    <resourceLossPerDay>0.05</resourceLossPerDay>
    <biostatMet>-2</biostatMet>
    <showGizmoOnWorldView>true</showGizmoOnWorldView>
    <showGizmoWhenDrafted>true</showGizmoWhenDrafted>
    
  </GeneDef>
  <GeneDef>
    <defName>OOPhoenixLords_BrighterBurn</defName>
    <label>brighter burn</label>
    <labelShortAdj>draining</labelShortAdj>
    <description>Carriers burn an additional 15 chemfuel per day due to the extra heat in their bodies.</description>
    <resourceLabel>chemfuel</resourceLabel>
    <geneClass>OOPhoenixLords.Gene_BrighterBurn</geneClass>
    <iconPath>UI/Icons/Genes/Gene_BrighterBurn</iconPath>
    <prerequisite>OOPhoenixLords_PhoenixFire</prerequisite>
    <resourceLossPerDay>0.15</resourceLossPerDay>
    <displayCategory>Phoenix</displayCategory>
    <displayOrderInCategory>-1</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>6</biostatMet>
  </GeneDef>

  <GeneDef>
    <defName>OOPhoenixLords_RapidAging</defName>
    <label>rapid aging</label>
    <description>Carriers of this gene age extremely rapidly. Their childhood will breeze past them in only a couple years. By the age of 18, their cells will have mostly settled, but they will still age 5 times faster than the average human.</description>
    <iconPath>UI/Icons/Genes/Gene_RapidAging</iconPath>
    <displayCategory>Phoenix</displayCategory>
    <biologicalAgeTickFactorFromAgeCurve>
      <points>
        <li>(0, 20)</li>
        <li>(3, 10)</li>
        <li>(13, 10)</li>
        <li>(18, 5)</li>
      </points>
    </biologicalAgeTickFactorFromAgeCurve>
    
    <statFactors>
      <OOPhoenixLords_GrowthPointsFactor>10.0</OOPhoenixLords_GrowthPointsFactor>
    </statFactors>
    <biostatCpx>3</biostatCpx>
    <biostatMet>2</biostatMet>
  </GeneDef>
  <GeneDef>
    <defName>OOPhoenixLords_Superheating</defName>
    <label>superheating</label>
    <description>Carriers of this gene are capable of using phoenix flames to continuously expell huge amounts amounts of heat from their bodies. They can choose the amount of heat they expel so it can be used to heat up rooms during the winter, or to cook enemies alive if they are foolish enough to enter an enclosed room with the pawn.</description>
    <iconPath>UI/Icons/Genes/Gene_Superheating</iconPath>
    <prerequisite>OOPhoenixLords_PhoenixFire</prerequisite>
    <displayCategory>Phoenix</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <displayCategory>Phoenix</displayCategory>
    <geneClass>OOPhoenixLords.Gene_Superheating</geneClass>
    <showGizmoOnWorldView>true</showGizmoOnWorldView>
    <showGizmoWhenDrafted>true</showGizmoWhenDrafted>
  </GeneDef>
  <GeneDef>
    <defName>OOPhoenixLords_HeatImpervious</defName>
    <label>heat impervious</label>
    <description>Carriers of this gene cannot catch on fire and will be comfortable even in the most extreme heat.</description>
    <iconPath>UI/Icons/Genes/Gene_HeatImpervious</iconPath>
    <displayCategory>Phoenix</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-4</biostatMet>
    <displayCategory>Phoenix</displayCategory>
    <statOffsets>
      <ComfyTemperatureMax>2000</ComfyTemperatureMax>
    </statOffsets>
    <statFactors>
      <Flammability>0</Flammability>
    </statFactors>
  </GeneDef>
  <GeneDef>
    <defName>OOPhoenixLords_ApparelIncineration</defName>
    <label>apparel incineration</label>
    <description>Due to their extreme body temperature, carriers of this gene are only able to wear apparel that has an armor heat value of 70% or more. Any other apparel placed on them will be quickly incinerated.</description>
    <iconPath>UI/Icons/Genes/Gene_ApparelIncineration</iconPath>
    <displayCategory>Phoenix</displayCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>4</biostatMet>
    <displayCategory>Phoenix</displayCategory>
    <geneClass>OOPhoenixLords.Gene_ApparelIncineration</geneClass>
  </GeneDef>

  <GeneDef>
    <defName>OOPhoenixLords_PhoenixFireSpew</defName>
    <label>phoenix fire spew</label>
    <description>Carriers are able to release a large burst of fresh phoenix flames from their hands. These flames will burn anything in a small area and can ignite people, objects, and the ground.</description>
    <iconPath>UI/Icons/Genes/Gene_PhoenixFireSpew</iconPath>
    <prerequisite>OOPhoenixLords_PhoenixFire</prerequisite>
    <displayCategory>Ability</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <abilities>
      <li>OOPhoenixLords_PhoenixFireSpew</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>OOPhoenixLords_PhoenixFireSpew</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-2</biostatMet>
    <symbolPack>
      <wholeNameSymbols>
        <li><symbol>burner</symbol></li>
        <li><symbol>igniter</symbol></li>
      </wholeNameSymbols>
      <prefixSymbols>
        <li><symbol>fire</symbol></li>
        <li><symbol>flame</symbol></li>
        <li><symbol>pyre</symbol></li>
        <li><symbol>pyro</symbol></li>
        <li><symbol>spark</symbol></li>
        <li><symbol>ember</symbol></li>
        <li><symbol>spew</symbol></li>
        <li><symbol>burn</symbol></li>
        <li><symbol>incendi</symbol></li>
        <li><symbol>cinder</symbol></li>
        <li><symbol>ash</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>light</symbol></li>
        <li><symbol>burner</symbol></li>
        <li><symbol>pyro</symbol></li>
        <li><symbol>ash</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
